   "execution_count": 48,
   "id": "71242e3b",
   "metadata": {},
   "outputs": [],
   "source": [
    "class ClassificationHead(nn.Module):\n",
    "    def __init__(self, d_in: int, num_classes: int):\n",
    "        super().__init__()\n",
    "        \n",
    "        self.net = MLP(in_dim=d_in, hidden_dim=56, out_dim=num_classes, depth=5, use_layernorm=True)\n",
    "\n",
    "    def forward(self, x: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        x: (..., d_in)\n",
    "        return: (..., num_classes) logits\n",
    "        \"\"\"\n",
    "        return self.net(x)"
   ]
  },
